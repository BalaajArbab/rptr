{
  "SpotifySettings": {
    "RedirectUri": "https://127.0.0.1:7088/api/authorization/callback"
  },
  "AuthRedirects": {
    "SuccessUri": "http://localhost:5173/auth/success",
    "FailureUri": "http://localhost:5173/"
  },
  "Database": {
    "ConnectionName": "LocalConnection"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "None"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "yyyy-MM-dd'T'HH:mm:ss.fff'Z' ",
        "UseUtcTimestamp": true
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  }
}
