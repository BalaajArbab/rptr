{
  "Database": {
    "ConnectionName": "AzureConnection"
  },
  "KeepWarmDispatch": {
    "Enabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "yyyy-MM-dd'T'HH:mm:ss.fff'Z' ",
        "UseUtcTimestamp": true
      }
    }
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
